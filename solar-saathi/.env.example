# Copy to .env.local and fill in. Never commit real keys.

# Sarvam AI (https://dashboard.sarvam.ai): natural Odia/Hindi/English voice for Saathi.
# Without it, Saathi uses the browser's built-in voice (usually no Odia).
SARVAM_API_KEY=

# Optional Bulbul v3 speaker. The copy is written in a male voice (e.g. Hindi "करूँगा"),
# so keep a male speaker: shubh (default), aditya, rahul, rohan, amit, dev, kabir…
SARVAM_SPEAKER=shubh

# Azure Speech free tier (F0, 5 lakh characters a month): the only free source of a
# natural Odia voice (or-IN-SukantNeural). portal.azure.com → create "Speech service",
# pricing tier F0 → Keys and Endpoint. English and Hindi work without it (free Edge voices).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Voice Lab (/voice-lab) is open in `npm run dev` only. Set to 1 to open it in production.
VOICE_LAB=

# Saathi's voice per language: engine:voice[:speed%]. Copy the lines from /voice-lab.
# Left empty: English = edge:en-IN-PrabhatNeural:+30, Hindi = edge:hi-IN-MadhurNeural:+30 (free),
# Odia = Azure or Sarvam if a key above is set, otherwise the browser's own voice.
TTS_EN=
TTS_HI=
TTS_OR=

# ── Email verification code ────────────────────────────────────────────
# Free with Gmail (500 recipients/day): turn on 2-Step Verification for the
# Gmail account, then create an App Password at
# https://myaccount.google.com/apppasswords and paste its 16 letters below.
SMTP_USER=
SMTP_PASS=
# Other providers (Brevo, Zoho, Resend, Outlook…): also set host and port (465 or 587).
SMTP_HOST=
SMTP_PORT=
# Optional sender name/address shown to the customer.
EMAIL_FROM=
# Signs the mobile and email code tickets. REQUIRED in production (Vercel):
# 32+ random characters. Without it no codes are sent. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
# Dev only: EMAIL_TEST=ethereal sends to a throwaway test inbox (link in the server log).
# With no SMTP set, development shows the code on screen instead of emailing it.
EMAIL_TEST=

# ── Mobile OTP by SMS ──────────────────────────────────────────────────
# OFF by default (each SMS costs money): the number is only checked (10 digits,
# real Indian mobile range, no 9999999999-style placeholders), then the user
# goes straight to the email step. Set to "on" to send and check an SMS code
# (needs the MC_ keys below). NEXT_PUBLIC_: redeploy / restart after changing.
NEXT_PUBLIC_SMS_OTP=
# Message Central VerifyNow (https://www.messagecentral.com): no DLT registration,
# no monthly fee, free signup credits, then ₹0.20 per OTP (pay only if you top up).
# Sign up → Verify Now → copy the Customer ID (C-…); the password is your
# Message Central login password. Message Central makes the code (valid ~60 s).
MC_CUSTOMER_ID=
MC_PASSWORD=
MC_EMAIL=
# With these empty, development shows the SMS code on screen instead of sending it.
# Check a deployment at /api/otp/status: it lists any missing setting (never values).
