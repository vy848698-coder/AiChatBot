# Copy to .env.local and fill in. Never commit real keys.

# Sarvam AI (https://dashboard.sarvam.ai): natural Odia/Hindi/English voice for Saathi.
# Without it, Saathi uses the browser's built-in voice (usually no Odia).
SARVAM_API_KEY=

# Optional Bulbul v3 speaker. The copy is written in a male voice (e.g. Hindi "करूँगा"),
# so keep a male speaker: shubh (default), aditya, rahul, rohan, amit, dev, kabir…
SARVAM_SPEAKER=shubh
