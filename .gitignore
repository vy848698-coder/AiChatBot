# ── secrets ─────────────────────────────────────────────
# Real keys (Sarvam etc.) live in .env.local — never commit them.
.env
.env.*
!.env.example

# ── client documents ────────────────────────────────────
# The client's requirement PDF is confidential; this repo is public.
*.pdf

# ── dependencies ────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js / build output ──────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.vercel

# ── logs & caches ───────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
coverage/
.eslintcache
.cache/

# ── editors / OS / local tools ──────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json
